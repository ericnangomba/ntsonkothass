# SPA fallback for client-side routes (added 2026-11-17). /api and URLs that
# name a file keep their real server status (404 when missing); real files and
# directories (assets, .well-known, cgi-bin) are served directly.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^api/ - [L]
RewriteCond %{REQUEST_URI} \.[a-zA-Z0-9]{1,8}$
RewriteRule ^ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]
</IfModule>
